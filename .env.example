# Charter Keke Environment Variables
# Copy this file to .env.local and fill in the actual values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# NextAuth Configuration
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key

# SMS Service (Termii)
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=CHARTERKEKE
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_WEBHOOK_SECRET=your_termii_webhook_secret
TERMII_REQUIRE_WEBHOOK_SIGNATURE=false
TERMII_SMS_FALLBACK_TO_GENERIC=true

# Redis Configuration (Optional - for production)
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=your_redis_token

# Payment Gateway (Paystack)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# Admin Dashboard
NEXT_PUBLIC_ADMIN_EMAIL=admin@charterkeke.com

# Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
